{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bestkojima/docprase/blob/main/docs/issue-4/document-ir-1.0.schema.json",
  "title": "DocumentIR 1.0（单页）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "status", "source", "pages", "resources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "pattern": "^doc-[0-9a-f]{16}$"},
    "status": {"$ref": "#/$defs/pageStatus"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type"], "properties": {"type": {"const": "image"}}
    },
    "pages": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/page"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
  },
  "$defs": {
    "pageStatus": {"enum": ["ok", "partial", "blank", "failed"]},
    "box": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "integer", "minimum": 0}
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["page_id", "page_index", "raster_size", "coordinate_space", "status", "reading_order", "layout_blocks", "regions", "blocks", "relations"],
      "properties": {
        "page_id": {"const": "p0001"},
        "page_index": {"const": 0},
        "raster_size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "coordinate_space": {"const": "raster_page"},
        "status": {"$ref": "#/$defs/pageStatus"},
        "reading_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^b[0-9]{4,}$"}},
        "layout_blocks": {"type": "array", "items": {"$ref": "#/$defs/layoutBlock"}},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "relations": {"type": "array", "maxItems": 0}
      }
    },
    "layoutBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "page_id", "label", "bbox", "coordinate_space", "detection_score", "candidate_rank", "provenance"],
      "allOf": [{
        "if": {"properties": {"label": {"const": "unknown"}}},
        "then": {"required": ["original_class_id"]}
      }],
      "properties": {
        "id": {"type": "string", "pattern": "^l[0-9]{4,}$"},
        "page_id": {"const": "p0001"},
        "label": {"enum": ["text", "formula", "table", "image", "unknown"]},
        "bbox": {"$ref": "#/$defs/box"},
        "coordinate_space": {"const": "raster_page"},
        "detection_score": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_rank": {"type": "integer", "minimum": 0},
        "original_class_id": {"type": "integer", "minimum": 0},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["model_profile", "request_id"],
          "properties": {"model_profile": {"type": "string"}, "request_id": {"type": "string"}}
        }
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "page_id", "source_layout_block_ids", "bbox", "coordinate_space"],
      "properties": {
        "id": {"type": "string", "pattern": "^r[0-9]{4,}$"},
        "page_id": {"const": "p0001"},
        "source_layout_block_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^l[0-9]{4,}$"}},
        "bbox": {"$ref": "#/$defs/box"},
        "coordinate_space": {"const": "raster_page"}
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "page_id", "type", "source_region_ids", "bbox", "coordinate_space", "geometry_granularity", "reading_order_source", "status", "confidence", "content", "provenance", "error", "error_base64"],
      "properties": {
        "id": {"type": "string", "pattern": "^b[0-9]{4,}$"},
        "page_id": {"const": "p0001"},
        "type": {"enum": ["text", "formula", "table", "image", "unknown"]},
        "source_region_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^r[0-9]{4,}$"}},
        "bbox": {"$ref": "#/$defs/box"},
        "coordinate_space": {"const": "raster_page"},
        "geometry_granularity": {"const": "region"},
        "reading_order_source": {"const": "geometry"},
        "status": {"enum": ["ok", "partial", "failed", "skipped"]},
        "confidence": {"type": "null"},
        "content": {
          "type": "object", "additionalProperties": false,
          "required": ["format", "text", "resource"],
          "properties": {
            "format": {"enum": ["markdown", "latex", "html", "resource"]},
            "text": {"type": "string"},
            "resource": {"type": ["string", "null"]},
            "display": {"type": "boolean"}
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["model_profile", "request_id", "raw_output", "raw_output_base64", "text_base64"],
          "properties": {
            "model_profile": {"type": "string"},
            "request_id": {"type": "string"},
            "raw_output": {"type": ["string", "null"]},
            "raw_output_base64": {"type": ["string", "null"]},
            "text_base64": {"type": ["string", "null"]}
          }
        },
        "error": {"type": ["string", "null"]},
        "error_base64": {"type": ["string", "null"]}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "media_type", "source_block_id", "width", "height", "bbox", "coordinate_space"],
      "properties": {
        "id": {"type": "string"},
        "path": {"type": "string", "pattern": "^assets/p0001-b[0-9]{4,}\\.png$"},
        "media_type": {"const": "image/png"},
        "source_block_id": {"type": "string", "pattern": "^b[0-9]{4,}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/box"},
        "coordinate_space": {"const": "raster_page"}
      }
    }
  }
}
