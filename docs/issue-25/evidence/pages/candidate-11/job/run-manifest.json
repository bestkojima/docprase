d_tokens","pad_offset":[0,0],"rounding_error":[0.0,-0.3988044406490161],"scale":1.0111016225448335,"token_count":148}}],"configured_generation_budget_ms":120000,"generation_elapsed_ms":3532,"max_attempts":2,"max_total_generation_budget_ms":240000,"policy":"targeted-retry-v1","selected_attempt":1}},{"request_id":"reqr0018","status":"ok","stop_reason":"normal","elapsed_ms":3541,"recognition":{"attempts":[{"config":{"generation_timeout_ms":120000,"max_new_tokens":512,"visual_max_pixels":313600,"visual_min_pixels":65536},"correction":"initial","elapsed_ms":3540,"index":1,"input_visual":null,"output":{"error":"","error_base64":null,"finish_reason":"complete","generation_elapsed_ms":2806,"raw_output":"作亭者谁？山之僧智仙也。名之者谁？太守自谓也。太守与客来饮于此，饮少辄(zhé)醉，而年又最高，故自号曰“醉翁”也。醉翁之意不在酒，在乎山水之间也。山水之乐，得之心而寓之酒也。\n","raw_output_base64":null,"stop_reason":"normal","text":"作亭者谁？山之僧智仙也。名之者谁？太守自谓也。太守与客来饮于此，饮少辄(zhé)醉，而年又最高，故自号曰“醉翁”也。醉翁之意不在酒，在乎山水之间也。山水之乐，得之心而寓之酒也。\n","text_base64":null},"visual":{"canvas_size":[1184,128],"content_size":[1184,127],"evidence":"image_pad_tokens","pad_offset":[0,0],"rounding_error":[2.2737367544323206e-13,-0.07325383304939237],"scale":1.008517887563884,"token_count":148}}],"configured_generation_budget_ms":120000,"generation_elapsed_ms":2806,"max_attempts":2,"max_total_generation_budget_ms":240000,"policy":"targeted-retry-v1","selected_attempt":1}},{"request_id":"reqr0019","status":"ok","stop_reason":"normal","elapsed_ms":3819,"recognition":{"attempts":[{"config":{"generation_timeout_ms":120000,"max_new_tokens":512,"visual_max_pixels":313600,"visual_min_pixels":65536},"correction":"initial","elapsed_ms":3819,"index":1,"input_visual":null,"output":{"error":"","error_base64":null,"finish_reason":"complete","generation_elapsed_ms":3092,"raw_output":"若夫(fú)日出而林霏(fēi)开，云归而岩穴(xué)暝(míng)，晦(huì)明变化者，山间之朝暮也野芳发而幽香，佳木秀而繁阴，风霜高洁，水落而石出者，山间之四时也。朝而往，暮而归，四时之景不同，而乐亦无穷也。\n","raw_output_base64":null,"stop_reason":"normal","text":"若夫(fú)日出而林霏(fēi)开，云归而岩穴(xué)暝(míng)，晦(huì)明变化者，山间之朝暮也野芳发而幽香，佳木